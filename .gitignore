# ==========================================
# NeuraStitch Professional Gitignore
# ==========================================

# OS/System Files
.DS_Store
Thumbs.db
*.log

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.project
.classpath
.settings/

# ==========================================
# Python Backend Caches and Virtual Envs
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
active_env/

# Python test / coverage / linting
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Local databases
*.db
*.sqlite
*.sqlite3

# ==========================================
# Frontend (Node / Next.js)
# ==========================================
node_modules/
/frontend/node_modules/
.next/
/frontend/.next/
out/
/frontend/out/
.vercel/
.turbo/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Secrets and Environment Variables (CRITICAL)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local