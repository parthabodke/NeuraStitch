# =========================================================================
# NEXTGEN CORE BACKEND CONFIGURATION (.env)
# Rename this file to '.env' and populate the credentials.
# =========================================================================

# 1. NEON SERVERLESS POSTGRESQL CONNECTION STRING
# Get it from: https://neon.tech
# Make sure to use the 'pooled' connection URL for high concurrency.
DATABASE_URL=postgresql://[user]:[password]@[host]/[dbname]?sslmode=require

# 2. QDRANT CLOUD ENDPOINT & API KEY
# Get it from: https://qdrant.to/cloud
# Create a free-tier cluster and copy the Cluster URL (including https:// and port 6333 or similar).
QDRANT_HOST=https://xxxxxx-xxxx-xxxx.gcp.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# 3. MASTER PROVIDER API KEYS (Server-Side Fallbacks & Embeddings)
# You can populate these master keys on the server. If a client accesses the system
# without providing their own headers in the wallet UI, the backend will fallback to these keys.

# A. MASTER GROQ API KEY (Default #1 Embedding Provider: nomic-embed-text-v1.5)
# Get it from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# B. MASTER OPENAI API KEY (For text-embedding-3-small / GPT Chat Routing)
# Get it from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# C. MASTER OPENROUTER API KEY (For dynamic model catalog listings and fallbacks)
# Get it from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# D. MASTER GEMINI API KEY (Only used for Gemini LLM chat routing fallback)
# Get it from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
